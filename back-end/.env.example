# App
PORT=3000
NODE_ENV=development
FRONT_END_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=multitenant
DATABASE_PASSWORD=multitenant
DATABASE_NAME=multitenant

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Mesmo valor no build do frontend e no processo da API
NEXT_PUBLIC_ATHLETE_SELF_REGISTRATION_ENABLED=false
# OAuth Google: este ID deve coincidir com NEXT_PUBLIC_GOOGLE_CLIENT_ID no frontend
GOOGLE_CLIENT_ID=

# PASSWORD RESET SECRET
PASSWORD_RESET_SECRET=

# Organização principal (sem tabela — apenas config)
ORG_NAME="Minha Empresa"
ORG_ADMIN_EMAIL=admin@system.com
ORG_ADMIN_PASSWORD=

# Usuário de sistema (operações automatizadas do bootstrap)
# Gerar com: openssl rand -base64 32
SYS_USER_PASSWORD=
